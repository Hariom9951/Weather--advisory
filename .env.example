# Copy to .env (git-ignored) and fill in. Never commit .env.
WEATHERBOT_PROVIDER=gemini          # gemini | groq | anthropic
GEMINI_API_KEY=your-key-here        # free key: https://aistudio.google.com
# GROQ_API_KEY=your-key-here        # if WEATHERBOT_PROVIDER=groq
# ANTHROPIC_API_KEY=your-key-here   # if WEATHERBOT_PROVIDER=anthropic
# WEATHERBOT_MODEL=                 # optional override (defaults: gemini gemini-3.5-flash-lite, groq openai/gpt-oss-120b, anthropic claude-sonnet-5-5)
